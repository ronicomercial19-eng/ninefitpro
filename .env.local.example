# Variáveis de Ambiente - FitPro Integration
# Copie este arquivo para .env.local e preencha com seus valores

# =============================================
# SUPABASE
# =============================================
REACT_APP_SUPABASE_URL=https://mfrydtrzjxscbkaiwfnw.supabase.co
REACT_APP_SUPABASE_ANON_KEY=seu_anon_key_aqui
REACT_APP_SUPABASE_SERVICE_KEY=seu_service_key_aqui

# =============================================
# FITPRO API
# =============================================
REACT_APP_FITPRO_API_KEY=seu_fitpro_api_key_aqui
REACT_APP_FITPRO_BASE_URL=https://mfrydtrzjxscbkaiwfnw.supabase.co/functions/v1/fitpro-api

# =============================================
# AMBIENTE
# =============================================
NODE_ENV=development
VITE_ENV=development

# =============================================
# FILEPOND (Upload de imagens)
